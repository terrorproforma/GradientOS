[Unit]
Description=Gradient Robotics Arm Controller
Wants=gradient-rt-motion.service
After=network.target gradient-rt-motion.service

StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple

User=pi
Group=pi

WorkingDirectory=/home/pi/GradientOS

Environment=PATH=/home/pi/GradientOS/.venv/bin:/home/pi/.local/bin:/home/pi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/pi/GradientOS/src
Environment=GRADIENT_RTCORE_AUTOSTART=1
# Use for explicit serial port override instead of auto-detection
# Environment=SERIAL_PORT=/dev/ttyUSB0

ExecStart=/home/pi/GradientOS/run.sh

Restart=always
RestartSec=15

TimeoutStopSec=60

ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/GradientOS /home/pi/.cache /home/pi/.config
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
