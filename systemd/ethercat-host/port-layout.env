# Single source of truth for RevPi NIC role assignment.
#
# To swap the EtherCAT-facing physical port, change ETHERCAT_PORT only and then run:
#   cd systemd/ethercat-host
#   bash ./render-generated-files.sh
#   ./install.sh
#
# Valid values: eth0 or eth1.
ETHERCAT_PORT="eth0"

# Stable physical MACs for this RevPi host.
ETH0_MAC="c8:3e:a7:14:1c:75"
ETH1_MAC="c8:3e:a7:14:1c:76"

# Desired deterministic post-reboot names.
ETHERCAT_RENAMED_IFACE="ethercat0"
UPLINK_RENAMED_IFACE="uplink0"

# IgH master device module policy.
ETHERCAT_DEVICE_MODULES="generic"

# Managed uplink connection profile rendered by install.sh.
# This follows the computed non-EtherCAT NIC by MAC address, so it keeps
# working across eth0/eth1 renames and after uplink/ethercat role swaps.
# On this host the normal uplink is expected to come from Windows Internet
# Connection Sharing on the main computer, so the RevPi should DHCP on eth1
# and accept the shared connection as its default route.
UPLINK_NM_CONNECTION_ID="Gradient Uplink"
UPLINK_AUTOCONNECT="true"
UPLINK_IPV4_METHOD="auto"
UPLINK_IPV4_ADDRESS=""
UPLINK_IPV4_GATEWAY=""
UPLINK_IPV4_DNS=""
UPLINK_IPV4_NEVER_DEFAULT="false"
UPLINK_IPV6_METHOD="ignore"
UPLINK_IPV6_NEVER_DEFAULT="false"
